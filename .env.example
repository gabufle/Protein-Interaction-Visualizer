# Environment variables template
# Copy this file to .env and fill in your actual API keys
#
# How to use:
#   cp .env.example .env
#   # Edit .env and add your keys
#
# Then load them (automatic with python-dotenv):
#   from dotenv import load_dotenv
#   load_dotenv()  # reads .env file in current directory

# -------------------------------------------
# STRING Database API Key
# -------------------------------------------
# Register at: https://string-db.org/cgi/access?section=api
# Benefits: Higher rate limit (100k requests vs 10/hour), no CAPTCHA
# Without key: limited to ~10 requests/minute, may show CAPTCHA
STRING_API_KEY=your_string_api_key_here

# -------------------------------------------
# BioGRID Credentials (optional)
# -------------------------------------------
# BioGRID allows optional registration for higher limits
# Public access: no key needed but limited
# Register at: https://thebiogrid.org/
BIOGRID_USERNAME=your_biogrid_username
BIOGRID_PASSWORD=your_biogrid_password

# -------------------------------------------
# Other APIs (future extensions)
# -------------------------------------------
# UniProt API key (for protein sequences): https://www.uniprot.org/
UNIPROT_API_KEY=your_uniprot_key

# NCBI Entrez email (required by NCBI policy for API use)
# Entrez will block excessive requests without contact info
NCBI_EMAIL=your_email@example.com
