# Git ignore for Protein Interaction Visualizer
# ================================================

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb
!notebooks/  # keep notebook directory
notebooks/*.ipynb
!notebooks/example_*.ipynb  # keep example notebooks

# Data files (raw and processed)
# Commit small sample files for reproducibility, ignore large datasets
data/raw/*.csv
data/raw/*.tsv
data/raw/*.zip
data/processed/*.csv
data/processed/*.pkl
data/processed/*.pickle
# But keep empty placeholder files
!.gitkeep

# Results and outputs
results/figures/*.png
results/figures/*.svg
results/figures/*.html
results/predictions/*.csv
results/predictions/*.pkl
logs/*.log

# Models (trained ML models)
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt

# Environment variables (secrets!)
.env
*.env.local

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Conda environment
conda/
conda-env.yml

# Temporary Python files
tmp/
temp/
.cache/

# Package build
*.egg
*.whl

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Documentation build
docs/_build/
site/

# Hermes Agent integration
.hermes/
hermes-agent/
